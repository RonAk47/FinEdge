    {
      "name": "Summary",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Overall summary",
          "request": {
            "method": "GET",
            "header": [],
